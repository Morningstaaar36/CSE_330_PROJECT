        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Stage 2: MDGTDTInet Fine-tuning Pipeline (Affinity Prediction)\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam TitleFontSize 20\nskinparam ArrowColor #2C3E50\nskinparam ArrowThickness 2\n\n&#39; Define Colors\n!define DRUG_COLOR #EBF5FB\n!define PROT_COLOR #FEF9E7\n!define INTERACT_COLOR #F5EEF8\n!define HEAD_COLOR #E8F8F5\n\npackage \&quot;Input Data &amp; Pretrained Weights\&quot; #F8F9F9 {\n    [Drug Graph] as DG #AED6F1\n    [Protein Graph] as PG #F9E79F\n    [ESM Protein Embedding] as ESM_IN #F9E79F\n    file \&quot;Stage 1 Weights\&quot; as S1W #D5F5E3\n}\n\npackage \&quot;Encoders (Initialized from Stage 1)\&quot; #D5F5E3 {\n    node \&quot;GraphTransformerCompound\&quot; as GTC #58D68D\n    node \&quot;GraphTransformerProtein\&quot; as GTP #58D68D\n}\n\npackage \&quot;Protein Modality Fusion\&quot; #FEF9E7 {\n    [Linear Projection (320 -&gt; 128)] as PROJ #F7DC6F\n    component \&quot;Cross-Attention Module\&quot; as CROSS_ATTN #F7DC6F\n}\n\npackage \&quot;Interaction Module\&quot; #F5EEF8 {\n    [Bilinear / Einsum Interaction] as EINSUM #D7BDE2\n    [Joint-Attention (Sigmoid)] as JOINT_ATTN #D7BDE2\n    database \&quot;Interaction Matrix\&quot; as INT_MAT #D7BDE2\n}\n\npackage \&quot;Prediction Head\&quot; #E8F8F5 {\n    node \&quot;Regression MLP\\n(1024 -&gt; 1024 -&gt; 256 -&gt; 1)\&quot; as MLP #76D7C4\n    [Affinity Score (Kd)] as OUT #48C9B0\n}\n\n&#39; Load Weights\nS1W ..&gt; GTC : Load\nS1W ..&gt; GTP : Load\n\n&#39; Drug Path\nDG --&gt; GTC : Forward\nGTC --&gt; EINSUM : Compound Feats\n\n&#39; Protein Path\nPG --&gt; GTP : Forward\nESM_IN --&gt; PROJ : Forward\nPROJ --&gt; CROSS_ATTN : Query\nGTP --&gt; CROSS_ATTN : Key/Value\nCROSS_ATTN --&gt; EINSUM : Fused Protein Feats\n\n&#39; Interaction Path\nEINSUM --&gt; JOINT_ATTN : Calculate\nJOINT_ATTN --&gt; INT_MAT : Weighting\nINT_MAT --&gt; MLP : Joint Embedding\nMLP --&gt; OUT : Predict\n\nlegend bottom\n  |= Color |= Component Type |\n  |&lt;#AED6F1&gt;| Drug Branch |\n  |&lt;#F9E79F&gt;| Protein Branch |\n  |&lt;#58D68D&gt;| Pretrained Components |\n  |&lt;#D7BDE2&gt;| Multi-modal Interaction |\n  |&lt;#76D7C4&gt;| Task-specific Head |\nendlegend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="r8EeyYhcoAgISKs1fLSx-1">
