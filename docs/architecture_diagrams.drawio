<mxfile host="app.diagrams.net">

  <!-- ===== TAB 1: Data & Cold-Start CV ===== -->
  <diagram name="1. Data &amp; Cold-Start CV" id="tab-data-cv">
    <mxGraphModel dx="1717" dy="867" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Step 1: Data Preprocessing &amp; Cold-Start Cross-Validation\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam TitleFontSize 20\nskinparam ArrowColor #2C3E50\nskinparam ArrowThickness 2\n\npackage \&quot;Davis Dataset\&quot; #F8F9F9 {\n    database \&quot;24,820 Drug-Protein Pairs\\n68 Drugs x 365 Proteins\\nLabel: pKd Affinity (REG_LABEL)\&quot; as DAVIS #D5F5E3\n}\n\npackage \&quot;Drug Processing Pipeline\&quot; #EBF5FB {\n    [SMILES Strings] as SMILES #AED6F1\n    node \&quot;RDKit\\n(SMILES -> Molecular Graph)\&quot; as RDKIT #85C1E9\n    artifact \&quot;Drug Graph (.pt)\\n---\\nNode Features: 44-dim\\n(atom type, degree, H-bonds, aromaticity)\\nEdge Features: 10-dim\\n(bond type, conjugation, ring)\\nLaplacian PE: 8-dim\&quot; as DRUG_GRAPH #AED6F1\n}\n\npackage \&quot;Protein Processing Pipeline\&quot; #FEF9E7 {\n    [Protein Sequence] as PROTSEQ #F9E79F\n    node \&quot;PconsC4\\n(Contact Map Prediction)\&quot; as PCONSC4 #F7DC6F\n    node \&quot;AlphaFold2\\n(3D Coordinates - CA atoms)\&quot; as AF2 #F7DC6F\n    node \&quot;ESM-2\\n(Pretrained Protein LM)\&quot; as ESM #F7DC6F\n    artifact \&quot;Protein Graph (.pt)\\n---\\nNode Features: 41-dim\\n(residue one-hot, PSSM, properties)\\nEdge Features: 5-dim\\n(distance, angle, similarity)\\nLaplacian PE: 8-dim\&quot; as PROT_GRAPH #F9E79F\n    artifact \&quot;ESM Embedding (.npy)\\n[L x 320] per protein\&quot; as ESM_EMB #F9E79F\n}\n\npackage \&quot;Cold-Start Cross-Validation (5-Fold)\&quot; #F5EEF8 {\n    [ColdStartCrossValidator] as CSV #D7BDE2\n    frame \&quot;Random Split\\ntrain=14,892 | test=4,964\\nPairs split randomly\&quot; as RAND #E8DAEF\n    frame \&quot;Cold-Drug Split\\n42 train drugs | 13 test drugs\\nTest drugs NEVER seen in training\&quot; as COLD_D #FADBD8\n    frame \&quot;Cold-Protein Split\\n219 train prots | 73 test prots\\nTest proteins NEVER seen in training\&quot; as COLD_P #D4EFDF\n    frame \&quot;Cold-Both Split\\n42d x 219p train | 13d x 73p test\\nBOTH unseen - Hardest setting\&quot; as COLD_B #F5B7B1\n}\n\npackage \&quot;Output: Per-Fold CSVs\&quot; #E8F8F5 {\n    artifact \&quot;Davis_train.csv\\nDavis_val.csv\\nDavis_test.csv\&quot; as OUT_CSV #76D7C4\n}\n\nDAVIS --> SMILES : Drug IDs\nDAVIS --> PROTSEQ : Protein IDs\nSMILES --> RDKIT\nRDKIT --> DRUG_GRAPH\nPROTSEQ --> PCONSC4\nPROTSEQ --> AF2\nPROTSEQ --> ESM\nPCONSC4 --> PROT_GRAPH\nAF2 --> PROT_GRAPH\nESM --> ESM_EMB\n\nDAVIS --> CSV : All pairs\nCSV --> RAND\nCSV --> COLD_D\nCSV --> COLD_P\nCSV --> COLD_B\nRAND --> OUT_CSV\nCOLD_D --> OUT_CSV\nCOLD_P --> OUT_CSV\nCOLD_B --> OUT_CSV\n\nlegend bottom\n  |= Color |= Component Type |\n  |<#AED6F1>| Drug Data Pipeline |\n  |<#F9E79F>| Protein Data Pipeline |\n  |<#D7BDE2>| Cross-Validation |\n  |<#76D7C4>| Output Files |\nendlegend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="puml-data-cv">
          <mxCell style="shape=image;editableCssRules=.*;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,placeholder;" vertex="1" parent="1">
            <mxGeometry x="16" y="16" width="796" height="1100" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===== TAB 2: Graph Transformer Architecture ===== -->
  <diagram name="2. Graph Transformer" id="tab-gt">
    <mxGraphModel dx="1717" dy="867" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Step 2: Graph Transformer Encoder Architecture\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam TitleFontSize 20\nskinparam ArrowColor #2C3E50\nskinparam ArrowThickness 2\n\npackage \&quot;Input Graph\&quot; #F8F9F9 {\n    [Node Features (h)\\nDrug: 44-dim | Protein: 41-dim] as NODE_F #AED6F1\n    [Edge Features (e)\\nDrug: 10-dim | Protein: 5-dim] as EDGE_F #AED6F1\n    [Laplacian Positional Encoding\\n8-dim] as LAP_PE #D7BDE2\n    [Edge Index\\nAdjacency (COO format)] as EDGE_IDX #D5D8DC\n}\n\npackage \&quot;Input Projection\&quot; #FEF9E7 {\n    node \&quot;linear_h\\nnode_dim -> 128\&quot; as LIN_H #F7DC6F\n    node \&quot;linear_e\\nedge_dim -> 128\&quot; as LIN_E #F7DC6F\n    node \&quot;embedding_lap_pos_enc\\n8 -> 128 (added to h)\&quot; as LIN_PE #F7DC6F\n    [InFeatDropout] as DROPOUT_IN #F9E79F\n}\n\npackage \&quot;GraphTransformerLayer x N  (N = NUM_LAYERS)\&quot; #EBF5FB {\n\n    package \&quot;MultiHeadAttentionLayer (4 heads, d_k=32)\&quot; #D4E6F1 {\n        [Q = W_Q . h[dst]] as Q #AED6F1\n        [K = W_K . h[src]] as K #AED6F1\n        [V = W_V . h[src]] as V #AED6F1\n        [E_proj = W_E . e] as E_PROJ #AED6F1\n        node \&quot;score = (Q . K / sqrt(d_k)) * E_proj\\nsoftmax per dst node\\nweighted sum of V\&quot; as SCORE #85C1E9\n        artifact \&quot;Output: updated h + updated e\\n[nodes, 128] + [edges, 128]\&quot; as MHA_OUT #5DADE2\n    }\n\n    package \&quot;Post-Attention\&quot; #D5F5E3 {\n        node \&quot;O_h: Linear(128->128)\\nO_e: Linear(128->128)\&quot; as OUT_PROJ #58D68D\n        [+ Residual Connection] as RESID1 #ABEBC6\n        [LayerNorm] as LN1 #ABEBC6\n    }\n\n    package \&quot;Feed-Forward Network\&quot; #FEF9E7 {\n        node \&quot;FFN: 128 -> 256 -> 128\\n(ReLU + Dropout)\&quot; as FFN #F7DC6F\n        [+ Residual Connection] as RESID2 #ABEBC6\n        [LayerNorm] as LN2 #ABEBC6\n    }\n}\n\npackage \&quot;Output\&quot; #E8F8F5 {\n    artifact \&quot;Node Features [num_nodes, 128]\\n(per-atom for drugs, per-residue for proteins)\&quot; as GT_OUT #76D7C4\n}\n\nNODE_F --> LIN_H\nEDGE_F --> LIN_E\nLAP_PE --> LIN_PE\nLIN_H --> DROPOUT_IN : h + PE\nDROPOUT_IN --> Q\nDROPOUT_IN --> K\nDROPOUT_IN --> V\nLIN_E --> E_PROJ\nQ --> SCORE\nK --> SCORE\nV --> SCORE\nE_PROJ --> SCORE\nSCORE --> MHA_OUT\nMHA_OUT --> OUT_PROJ\nOUT_PROJ --> RESID1\nRESID1 --> LN1\nLN1 --> FFN\nFFN --> RESID2\nRESID2 --> LN2\nLN2 --> GT_OUT\n\nnote bottom of GT_OUT\n  Two separate instances (weights NOT shared):\n  * **GraphTransformerCompound** - for drug molecular graphs\n  * **GraphTransformerProtein** - for protein contact graphs\n  Same architecture, different input projection dimensions.\nend note\n\nlegend bottom\n  |= Color |= Component Type |\n  |<#AED6F1>| Attention Components |\n  |<#F7DC6F>| Projection / FFN |\n  |<#ABEBC6>| Residual + Normalization |\n  |<#76D7C4>| Output |\nendlegend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="puml-gt">
          <mxCell style="shape=image;editableCssRules=.*;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,placeholder;" vertex="1" parent="1">
            <mxGeometry x="16" y="16" width="796" height="1100" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===== TAB 3: Stage 1 X-CLR ===== -->
  <diagram name="3. Stage 1 - X-CLR Pretraining" id="tab-s1">
    <mxGraphModel dx="1717" dy="867" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Stage 1: X-CLR Contrastive Pretraining\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam TitleFontSize 20\nskinparam ArrowColor #2C3E50\nskinparam ArrowThickness 2\n\npackage \&quot;Drug Branch (Learned)\&quot; #EBF5FB {\n    [Drug Graph] as DG #AED6F1\n    node \&quot;compound_gt\\n(GraphTransformerCompound)\&quot; as COMP_GT #85C1E9\n    [Mean Pool -> [B, 128]] as DRUG_POOL #AED6F1\n    node \&quot;ProjectionHead\\n128 -> 128 -> 128\\n+ L2 Normalize\\n-> z_drug\&quot; as DRUG_PROJ #5DADE2\n}\n\npackage \&quot;Drug Oracle (Frozen)\&quot; #E8F8F5 {\n    [SMILES Strings] as SMILES #76D7C4\n    node \&quot;ChemBERTa (frozen)\\n768-dim [CLS] token\&quot; as CHEMBERTA #48C9B0\n    [Pairwise Cosine Sim\\n-> g_soft_drug [B x B]] as DRUG_SIM #76D7C4\n}\n\npackage \&quot;Protein Branch (Learned)\&quot; #FEF9E7 {\n    [Protein Graph] as PG #F9E79F\n    node \&quot;protein_gt\\n(GraphTransformerProtein)\&quot; as PROT_GT #F7DC6F\n    [Mean Pool -> [B, 128]] as PROT_POOL #F9E79F\n    node \&quot;ProjectionHead\\n128 -> 128 -> 128\\n+ L2 Normalize\\n-> z_protein\&quot; as PROT_PROJ #F0B27A\n}\n\npackage \&quot;Protein Oracle (Frozen)\&quot; #E8F8F5 {\n    [ESM Embedding [B, L, 320]] as ESM_IN #76D7C4\n    [Mean Pool -> L2 Norm\\n-> [B, 320]] as ESM_POOL #76D7C4\n    [Pairwise Cosine Sim\\n-> g_soft_protein [B x B]] as PROT_SIM #76D7C4\n}\n\npackage \&quot;DualXCLRLoss\&quot; #FDEDEC {\n    node \&quot;Drug X-CLR Loss\\n---\\nsim(z_drug) = z . z^T / tau\\ntargets = softmax(g_soft / tau_s)\\nLoss = H(targets, log_softmax(sim))\\ntau=0.1, tau_s=0.05\&quot; as XCLR_D #F5B7B1\n    node \&quot;Protein X-CLR Loss\\n---\\nSame structure as Drug:\\nsim(z_protein) vs g_soft_protein\&quot; as XCLR_P #F5B7B1\n    artifact \&quot;L_total = L_drug + L_protein\&quot; as TOTAL_LOSS #E74C3C\n}\n\npackage \&quot;Output\&quot; #D5F5E3 {\n    artifact \&quot;Pretrained compound_gt weights (.pth)\\nPretrained protein_gt weights (.pth)\&quot; as S1_OUT #58D68D\n}\n\nDG --> COMP_GT : Forward\nCOMP_GT --> DRUG_POOL\nDRUG_POOL --> DRUG_PROJ\n\nSMILES --> CHEMBERTA : Tokenize\nCHEMBERTA --> DRUG_SIM\n\nPG --> PROT_GT : Forward\nPROT_GT --> PROT_POOL\nPROT_POOL --> PROT_PROJ\n\nESM_IN --> ESM_POOL\nESM_POOL --> PROT_SIM\n\nDRUG_PROJ --> XCLR_D : z_drug\nDRUG_SIM --> XCLR_D : Soft targets\n\nPROT_PROJ --> XCLR_P : z_protein\nPROT_SIM --> XCLR_P : Soft targets\n\nXCLR_D --> TOTAL_LOSS\nXCLR_P --> TOTAL_LOSS\nTOTAL_LOSS ..> S1_OUT : Save best\n\nnote bottom of S1_OUT\n  Training: Adam (lr=3e-4), batch=8 (accum=4x -> eff. 32)\n  Grad accumulation + clip_grad_norm(1.0)\n  ReduceLROnPlateau (factor=0.8, patience=5)\n  30-50 epochs, best checkpoint saved\nend note\n\nlegend bottom\n  |= Color |= Component Type |\n  |<#AED6F1>| Drug Branch (Trainable) |\n  |<#F9E79F>| Protein Branch (Trainable) |\n  |<#76D7C4>| Oracle Embeddings (Frozen) |\n  |<#F5B7B1>| Contrastive Loss |\n  |<#58D68D>| Pretrained Output |\nendlegend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="puml-s1">
          <mxCell style="shape=image;editableCssRules=.*;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,placeholder;" vertex="1" parent="1">
            <mxGeometry x="16" y="16" width="796" height="1100" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===== TAB 4: Stage 2 MDGTDTInet ===== -->
  <diagram name="4. Stage 2 - MDGTDTInet" id="tab-s2">
    <mxGraphModel dx="1717" dy="867" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Stage 2: MDGTDTInet Fine-tuning Pipeline (Affinity Prediction)\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam TitleFontSize 20\nskinparam ArrowColor #2C3E50\nskinparam ArrowThickness 2\n\npackage \&quot;Input Data &amp; Pretrained Weights\&quot; #F8F9F9 {\n    [Drug Graph] as DG #AED6F1\n    [Protein Graph] as PG #F9E79F\n    [ESM Protein Embedding\\n[B, L, 320]] as ESM_IN #F9E79F\n    file \&quot;Stage 1 Weights\&quot; as S1W #D5F5E3\n}\n\npackage \&quot;Encoders (Initialized from Stage 1)\&quot; #D5F5E3 {\n    node \&quot;GraphTransformerCompound\\n(compound_gt)\\n---\\nnode: 44->128, edge: 10->128\\n+ Laplacian PE (8->128)\\nN layers, 4 heads, 128-dim\&quot; as GTC #58D68D\n    node \&quot;GraphTransformerProtein\\n(protein_gt)\\n---\\nnode: 41->128, edge: 5->128\\n+ Laplacian PE (8->128)\\nN layers, 4 heads, 128-dim\&quot; as GTP #58D68D\n}\n\npackage \&quot;Shape Conversion\&quot; #F8F9F9 {\n    [pyg_batch_split\\nFlat nodes -> [B, max_d, 128]] as SPLIT_D #D5D8DC\n    [pyg_batch_split\\nFlat nodes -> [B, max_p, 128]] as SPLIT_P #D5D8DC\n}\n\npackage \&quot;Protein Modality Fusion\&quot; #FEF9E7 {\n    node \&quot;protein_embedding_fc\\nLinear(320 -> 128)\\n-> [B, L, 128]\&quot; as PROJ #F7DC6F\n    node \&quot;Cross-Attention (SelfAttention)\\n---\\nQ = ESM embeddings [B, L, 128]\\nK = V = Protein graph feats [B, max_p, 128]\\n1 head, 128-dim\\n-> protein_feats [B, L, 128]\&quot; as CROSS_ATTN #F7DC6F\n}\n\npackage \&quot;Interaction Module\&quot; #F5EEF8 {\n    node \&quot;Bilinear Interaction Attention\\n---\\n1. joint_attn_prot: W_p . ReLU(protein_feats)\\n2. joint_attn_comp: W_c . ReLU(compound_feats)\\n3. sigmoid(einsum bij,bkj->bik) -> attention\\n4. Normalize: attention / sum\\n5. tanh(einsum bij,bkj->bikj) -> joint feats\\n6. einsum bijk,bij->bk -> cp_embedding [B, 128]\&quot; as EINSUM #D7BDE2\n}\n\npackage \&quot;Prediction Head\&quot; #E8F8F5 {\n    node \&quot;Regression MLP (classifier)\\n---\\nLinear(128 -> 1024) + ReLU + Dropout(0.1)\\nLinear(1024 -> 1024) + ReLU + Dropout(0.1)\\nLinear(1024 -> 256) + ReLU + Dropout(0.1)\\nLinear(256 -> 1)\&quot; as MLP #76D7C4\n    artifact \&quot;Predicted Affinity (pKd)\&quot; as OUT #48C9B0\n}\n\npackage \&quot;Loss &amp; Optimization\&quot; #FDEDEC {\n    [MSE Loss vs Ground Truth] as MSE #F5B7B1\n    artifact \&quot;Adam (lr=1e-4)\\nReduceLROnPlateau\\n(factor=0.8, patience=10)\&quot; as OPTIM #FADBD8\n}\n\nS1W ..> GTC : Load pretrained\nS1W ..> GTP : Load pretrained\n\nDG --> GTC : Forward\nGTC --> SPLIT_D\n\nPG --> GTP : Forward\nGTP --> SPLIT_P\n\nESM_IN --> PROJ : Forward\nSPLIT_P --> CROSS_ATTN : Key/Value\nPROJ --> CROSS_ATTN : Query\n\nSPLIT_D --> EINSUM : Compound Feats\nCROSS_ATTN --> EINSUM : Fused Protein Feats\n\nEINSUM --> MLP : cp_embedding [B, 128]\nMLP --> OUT : Predict\nOUT --> MSE : Compare\n\nlegend bottom\n  |= Color |= Component Type |\n  |<#AED6F1>| Drug Branch |\n  |<#F9E79F>| Protein Branch |\n  |<#58D68D>| Pretrained Components |\n  |<#F7DC6F>| Modality Fusion |\n  |<#D7BDE2>| Multi-modal Interaction |\n  |<#76D7C4>| Task-specific Head |\n  |<#F5B7B1>| Loss |\nendlegend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="puml-s2">
          <mxCell style="shape=image;editableCssRules=.*;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,placeholder;" vertex="1" parent="1">
            <mxGeometry x="16" y="16" width="796" height="1100" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===== TAB 5: Evaluation ===== -->
  <diagram name="5. Evaluation" id="tab-eval">
    <mxGraphModel dx="1717" dy="867" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Step 5: Evaluation Metrics &amp; Cold-Start Scenarios\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam TitleFontSize 20\nskinparam ArrowColor #2C3E50\nskinparam ArrowThickness 2\n\npackage \&quot;Model Output\&quot; #F8F9F9 {\n    [Predicted Affinity (y_hat)] as PRED #AED6F1\n    [Ground Truth pKd (y)] as TRUE #AED6F1\n}\n\npackage \&quot;Regression Metrics\&quot; #EBF5FB {\n    node \&quot;MSE\\n---\\nmean((y - y_hat)^2)\\nLower is better\\nPrimary training objective\&quot; as MSE #85C1E9\n    node \&quot;RMSE\\n---\\nsqrt(MSE)\\nIn original pKd units\&quot; as RMSE #85C1E9\n}\n\npackage \&quot;Ranking Metric\&quot; #D5F5E3 {\n    node \&quot;CI (Concordance Index)\\n---\\nP(y_hat_i > y_hat_j | y_i > y_j)\\nRange: [0, 1], 0.5 = random\\nHigher is better\\nMeasures ranking quality\\nof predicted affinities\&quot; as CI #58D68D\n}\n\npackage \&quot;Correlation Metrics\&quot; #FEF9E7 {\n    node \&quot;Pearson r\\n---\\nLinear correlation\\nbetween predictions\\nand ground truth\\nRange: [-1, 1]\\nHigher is better\&quot; as PEARSON #F7DC6F\n    node \&quot;r_m^2 (Modified r-squared)\\n---\\nRoy et al. metric\\nPenalises systematic\\nover/under-prediction\\nHigher is better\&quot; as RM2 #F7DC6F\n}\n\npackage \&quot;Cold-Start Evaluation Scenarios\&quot; #F5EEF8 {\n    frame \&quot;Random\\n---\\nEntities overlap across splits\\nEasiest setting\\nBaseline comparison\&quot; as S_RAND #E8DAEF\n    frame \&quot;Cold-Protein\\n---\\n73 unseen test proteins\\nAll 68 drugs seen\\nModerate difficulty\&quot; as S_PROT #D4EFDF\n    frame \&quot;Cold-Drug\\n---\\n13 unseen test drugs\\nAll 365 proteins seen\\nHard: few drug structures\&quot; as S_DRUG #FADBD8\n    frame \&quot;Cold-Both\\n---\\n13 unseen drugs x 73 unseen proteins\\nNothing seen at test time\\nHardest setting in DTA\&quot; as S_BOTH #F5B7B1\n}\n\nPRED --> MSE\nTRUE --> MSE\nPRED --> CI\nTRUE --> CI\nPRED --> PEARSON\nTRUE --> PEARSON\n\nS_RAND -[hidden]-> S_PROT\nS_PROT -[hidden]-> S_DRUG\nS_DRUG -[hidden]-> S_BOTH\n\nnote bottom of S_BOTH\n  Difficulty ordering:\n  Random < Cold-Protein < Cold-Drug < Cold-Both\n  \n  Cold-Both on Davis (68 drugs x 365 proteins)\n  is one of the hardest settings in DTA literature.\n  SOTA cold-both CI ~ 0.50-0.60\nend note\n\nlegend bottom\n  |= Color |= Component Type |\n  |<#85C1E9>| Regression Metrics |\n  |<#58D68D>| Ranking Metric |\n  |<#F7DC6F>| Correlation Metrics |\n  |<#E8DAEF>| Evaluation Scenarios |\nendlegend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="puml-eval">
          <mxCell style="shape=image;editableCssRules=.*;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,placeholder;" vertex="1" parent="1">
            <mxGeometry x="16" y="16" width="796" height="1100" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===== TAB 6: Full Overview Pipeline ===== -->
  <diagram name="6. Full Overview" id="tab-overview">
    <mxGraphModel dx="1717" dy="867" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle MDGTDTInet: Full Pipeline Overview\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam TitleFontSize 20\nskinparam ArrowColor #2C3E50\nskinparam ArrowThickness 2\n\n|Step 1: Data|\n#F8F9F9:Davis Dataset\n24,820 pairs (68 drugs x 365 proteins);\n:Drug Graphs (.pt)\nProtein Graphs (.pt)\nESM Embeddings (.npy);\n:Cold-Start CV\n5-Fold Splits;\n\n|Step 2: Encoders|\n:GraphTransformerCompound\nDrug graph -> [num_atoms, 128];\n:GraphTransformerProtein\nProtein graph -> [num_residues, 128];\n\n|Step 3: Stage 1 X-CLR|\n:Contrastive Pretraining\n---\nDrug branch: compound_gt -> ProjectionHead -> z_drug\nProtein branch: protein_gt -> ProjectionHead -> z_protein\n---\nOracles: ChemBERTa (drug) + ESM (protein)\nX-CLR soft target contrastive loss\n---\nOutput: Pretrained encoder weights;\n\n|Step 4: Stage 2 MDGTDTInet|\n:Load Stage 1 Pretrained Weights\ninto compound_gt and protein_gt;\n:Drug Path:\nDrug Graph -> compound_gt -> pyg_batch_split\n-> compound_feats [B, max_d, 128];\n:Protein Path:\nProtein Graph -> protein_gt -> pyg_batch_split\nESM -> Linear(320->128)\nCross-Attention(Q=ESM, K=V=GraphFeats)\n-> protein_feats [B, L, 128];\n:Bilinear Interaction Attention\nsigmoid(W_p . prot x W_c . comp)\ntanh einsum -> cp_embedding [B, 128];\n:Regression MLP\n128 -> 1024 -> 1024 -> 256 -> 1;\n:Predicted Affinity (pKd);\n\n|Step 5: Evaluation|\n:Metrics: MSE, RMSE, CI, r_m^2, Pearson r;\n:Scenarios: Random | Cold-Drug | Cold-Protein | Cold-Both;\nstop\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="puml-overview">
          <mxCell style="shape=image;editableCssRules=.*;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,placeholder;" vertex="1" parent="1">
            <mxGeometry x="16" y="16" width="796" height="1100" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
